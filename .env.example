# DeceptionGuard Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env with real API keys

# NVIDIA NIM API Key (required for LLM intent extraction)
NVIDIA_API_KEY=

# NVIDIA NIM Base URL (default: NVIDIA's public endpoint)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA NIM Model (default: gpt-oss-20b)
NVIDIA_MODEL=openai/gpt-oss-20b